# Developer machine URLs after port-forward (same idea as BOOK_API_URL).
OLLAMA_URL=http://localhost:11434
AI_GATEWAY_URL=http://localhost:8080

# Internal AI API key (must match k8s/gateway/envoy.yaml RBAC).
# AI_API_KEY=

# Default MiniBank model served by the Ollama worker.
OLLAMA_MODEL=qwen2.5:1.5b-instruct
